{
  "kind": "singleType",
  "collectionName": "abouts",
  "info": {
    "singularName": "about",
    "pluralName": "abouts",
    "displayName": "About",
    "description": "About me section"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "tagline": {
      "type": "string",
      "required": true
    },
    "bio": {
      "type": "richtext",
      "required": true
    },
    "detailedBio": {
      "type": "richtext"
    },
    "email": {
      "type": "email"
    },
    "phone": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "profileImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "heroMedia": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "videos"]
    },
    "resumeFile": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["files"]
    },
    "socialLinks": {
      "type": "json"
    },
    "skills": {
      "type": "json"
    },
    "heroTitle": {
      "type": "string"
    },
    "heroSubtitle": {
      "type": "text"
    },
    "ctaButtonText": {
      "type": "string",
      "default": "View Projects"
    },
    "ctaButtonLink": {
      "type": "string",
      "default": "#projects"
    }
  }
}
